*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
display:flex;
justify-content:center;
align-items:center;
height:100vh;
background:linear-gradient(135deg,#667eea,#764ba2);
}

.player{
width:350px;
background:white;
padding:25px;
border-radius:20px;
box-shadow:0 10px 25px rgba(0,0,0,.3);
text-align:center;
}

.player img{
width:220px;
height:220px;
border-radius:15px;
object-fit:cover;
}

h2{
margin-top:15px;
}

p{
margin-bottom:15px;
color:gray;
}

.controls{
margin:20px;
}

.controls button{
font-size:28px;
margin:10px;
padding:12px;
border:none;
border-radius:50%;
background:#6c63ff;
color:white;
cursor:pointer;
transition:.3s;
}

.controls button:hover{
transform:scale(1.1);
}

#progress{
width:100%;
}

.volume{
margin:15px;
}

#volume{
width:80%;
}

.time{
display:flex;
justify-content:space-between;
margin-top:5px;
font-size:14px;
}

ul{
margin-top:20px;
text-align:left;
}

li{
padding:8px;
cursor:pointer;
}

li:hover{
background:#eee;
}
